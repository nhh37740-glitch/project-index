# Keep executable deployment scripts and Jenkins Pipeline sources shell-safe on
# Linux agents even when developers edit this repository on Windows.
* text=auto eol=lf

Jenkinsfile  text eol=lf
*.sh         text eol=lf
*.bash       text eol=lf
*.py         text eol=lf
*.conf       text eol=lf
*.html        text eol=lf
*.css         text eol=lf
*.svg         text eol=lf
*.md          text eol=lf

# Release archives and images are binary artifacts; Git must not rewrite them.
*.zip         binary
*.png         binary
*.jpg         binary
*.jpeg        binary
*.gif         binary
*.webp        binary
*.ico         binary
